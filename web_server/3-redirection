#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me to another page

apt-get update
apt-get install -y nginx

sed -i 's|server_name _;|server_name _;\n    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }|' /etc/nginx/sites-available/default

nginx -t
service nginx restart
