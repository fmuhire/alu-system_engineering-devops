#!/usr/bin/env bash
# Configures Nginx with a custom 404 page

apt-get update
apt-get install -y nginx

mkdir -p /var/www/html
printf "Ceci n'est pas une page\n" > /var/www/html/404.html

sed -i 's|server_name _;|server_name _;\n    error_page 404 /404.html;\n    location = /404.html {\n        internal;\n    }|' /etc/nginx/sites-available/default

nginx -t
service nginx restart
